# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain of the NPMplus admin UI (without https://)
APP_DOMAIN=npm.example.com

# Contact address for Let's Encrypt (expiry warnings)
ACME_EMAIL=admin@example.com

# Account that npmplus-docker-sync logs in with. Also becomes the initial admin.
NPM_SERVICE_USER=admin@example.com
# Generate: openssl rand -hex 32
NPM_SERVICE_PASSWORD=

# Group ID of the Docker socket on the host: ls -ln /var/run/docker.sock
DOCKER_GID=

# ════════════════════════════════════════════════════════════
#  REQUIRED FOR VARIANT authentik
# ════════════════════════════════════════════════════════════

# Full URL of Authentik including scheme and port
#AUTHENTIK_URL=https://auth.example.com:443

# ════════════════════════════════════════════════════════════
#  REQUIRED FOR VARIANT crowdsec
# ════════════════════════════════════════════════════════════

# Shared key between the NPMplus bouncer and CrowdSec – generate: openssl rand -hex 32
#CROWDSEC_BOUNCER_KEY=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# Network names (must be the same in every stack)
#NPM_PROXY_NETWORK=npm-proxy
#SOCKET_PROXY_NETWORK=socket-proxy

# Subnets and bridge names – change only if they collide with existing networks
#NPM_PROXY_NET_PREFIX=172.30.0
#NPM_PROXY_BRIDGE=br-npm
#SOCKET_PROXY_NET_PREFIX=172.31.0
#SOCKET_PROXY_BRIDGE=br-sockprx

# Variant crowdsec: connect the instance to the CrowdSec Console
#CROWDSEC_ENROLL_KEY=
#CROWDSEC_INSTANCE_NAME=

# NetBird IP of this host, only needed when the admin API port is enabled for remote hosts
#NETBIRD_IP=100.64.0.1
