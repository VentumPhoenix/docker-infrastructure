# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain (without https://)
APP_DOMAIN=auth.example.com

# Authentik version (image tag of server and worker), see https://goauthentik.io/docs/releases
APP_VERSION=2025.10

# Database password – generate: openssl rand -hex 32
DB_PASSWORD=

# Key for signing cookies and tokens. Never change it after setup.
# Generate: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# Name of the reverse proxy network (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy

# Outgoing email (STARTTLS)
#EMAIL_HOST=mail.example.com
#EMAIL_PORT=587
#EMAIL_USERNAME=
#EMAIL_PASSWORD=
#EMAIL_FROM=Authentik <auth@example.com>
