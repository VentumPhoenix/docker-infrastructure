# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain of the website (without https://)
APP_DOMAIN=www.example.com

# Image of your website, built e.g. by a GitHub Action
WEB_IMAGE=ghcr.io/you/website:latest

# Domain of the CMS (without https://)
DIRECTUS_DOMAIN=cms.example.com

# Directus secret key – generate: openssl rand -hex 32
DIRECTUS_SECRET=

# Database password of Directus – generate: openssl rand -hex 32
DIRECTUS_DB_PASSWORD=

# First Directus admin (only used on the first start)
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=

# ════════════════════════════════════════════════════════════
#  REQUIRED FOR VARIANT pretix
# ════════════════════════════════════════════════════════════

# Domain of the booking system and shop (without https://)
#PRETIX_DOMAIN=tickets.example.com

# Database password of pretix – generate: openssl rand -hex 32
#PRETIX_DB_PASSWORD=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# Name of the reverse proxy network (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy

# Variant pretix: name of the instance (shown in emails and the UI)
#PRETIX_INSTANCE_NAME=pretix

# Variant pretix: outgoing email (STARTTLS)
#EMAIL_HOST=mail.example.com
#EMAIL_PORT=587
#EMAIL_USERNAME=
#EMAIL_PASSWORD=
#EMAIL_FROM=tickets@example.com
