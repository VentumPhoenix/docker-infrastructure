# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain (without https://)
APP_DOMAIN=influx.example.com

# Password of the admin user (only used on the first start)
INFLUXDB_ADMIN_PASSWORD=

# Admin API token (only used on the first start) – generate: openssl rand -hex 32
INFLUXDB_ADMIN_TOKEN=

# ════════════════════════════════════════════════════════════
#  REQUIRED FOR docker-compose.telegraf.yml (on every host to monitor)
# ════════════════════════════════════════════════════════════

# Public URL of InfluxDB
#INFLUXDB_URL=https://influx.example.com

# API token with write access to the bucket (create it in the InfluxDB UI)
#INFLUXDB_TOKEN=

# Group ID of the Docker socket on that host: ls -ln /var/run/docker.sock
#DOCKER_GID=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# Name of the reverse proxy network (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy

# Created on the first start (Telegraf uses INFLUXDB_ORG and INFLUXDB_BUCKET too)
#INFLUXDB_ADMIN_USER=admin
#INFLUXDB_ORG=homelab
#INFLUXDB_BUCKET=telegraf
#INFLUXDB_RETENTION=30d

# Telegraf: collection interval, host name in the metrics (empty = machine name),
# localhost ports of its health endpoint and of its socket proxy
#TELEGRAF_INTERVAL=30s
#TELEGRAF_HOSTNAME=
#TELEGRAF_HEALTH_PORT=8099
#TELEGRAF_SOCKET_PROXY_PORT=2376
