# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain of NetBird (without https://)
APP_DOMAIN=netbird.example.com

# Shared secret of the relay – generate: openssl rand -hex 32
NETBIRD_AUTH_SECRET=

# Encryption key of the database – generate: openssl rand -base64 32
# When migrating, copy server.store.encryptionKey from the old config.yaml UNCHANGED.
NETBIRD_STORE_ENCRYPTION_KEY=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Name of the reverse proxy network (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy

# Host port for STUN (UDP)
#NETBIRD_STUN_PORT=3478
