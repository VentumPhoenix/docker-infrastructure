# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain (without https://)
APP_DOMAIN=tandoor.example.com

# Database password – generate: openssl rand -hex 32
DB_PASSWORD=

# Django secret key (at least 50 characters) – generate: openssl rand -hex 32
TANDOOR_SECRET_KEY=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# Name of the reverse proxy network (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy

# Allow anyone who can reach the domain to create an account (1 = yes)
#TANDOOR_ALLOW_SIGNUP=0

# Outgoing email (STARTTLS)
#EMAIL_HOST=mail.example.com
#EMAIL_PORT=587
#EMAIL_USERNAME=
#EMAIL_PASSWORD=
#EMAIL_FROM=tandoor@example.com
