# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain of Nextcloud (without https://)
APP_DOMAIN=cloud.example.com

# Nextcloud version (image tag of app and cron). Upgrade one major version at a time!
APP_VERSION=32

# Public domains of Collabora and Whiteboard (without https://)
COLLABORA_DOMAIN=office.example.com
WHITEBOARD_DOMAIN=whiteboard.example.com

# Database passwords – generate each: openssl rand -hex 32
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Shared secret between Nextcloud and the Whiteboard server – generate: openssl rand -hex 32
WHITEBOARD_JWT_SECRET=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# Name of the reverse proxy network (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy

# SFTP access (rclone): credentials file on the host, host port, log level
#RCLONE_AUTH_FILE=/opt/rclone-sftp/auth.json
#RCLONE_SFTP_PORT=18022
#RCLONE_LOG_LEVEL=INFO
