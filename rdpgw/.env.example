# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain (without https://)
APP_DOMAIN=rdp.example.com

# Full URL of Authentik including scheme and port
AUTHENTIK_URL=https://auth.example.com:443

# OAuth2/OIDC provider in Authentik
RDPGW_OIDC_CLIENT_ID=
RDPGW_OIDC_CLIENT_SECRET=

# Session keys, exactly 32 characters each, all different. Generate each: openssl rand -hex 16
RDPGW_SESSION_KEY=
RDPGW_SESSION_ENCRYPTION_KEY=
RDPGW_PAA_TOKEN_SIGNING_KEY=
RDPGW_PAA_TOKEN_ENCRYPTION_KEY=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# Name of the reverse proxy network (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy

# Slug of the application in Authentik
#RDPGW_OIDC_SLUG=rdpgw
