# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public URL of InfluxDB
INFLUXDB_URL=https://influx.example.com

# API token with write access to the bucket (create it in the InfluxDB UI)
INFLUXDB_TOKEN=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Organization and bucket in InfluxDB (must match the influxdb stack)
#INFLUXDB_ORG=homelab
#INFLUXDB_BUCKET=telegraf

# Collection interval
#TELEGRAF_INTERVAL=30s

# Host name in the metrics (empty = host name of the machine)
#TELEGRAF_HOSTNAME=

# Localhost port of the health endpoint (Telegraf runs in the host network)
#TELEGRAF_HEALTH_PORT=8099

# Address of the socket proxy (must match the npmplus stack)
#SOCKET_PROXY_NET_PREFIX=172.31.0
#SOCKET_PROXY_PORT=2375
