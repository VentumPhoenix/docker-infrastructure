# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain (without https://)
APP_DOMAIN=recipes.example.com

# Database password – generate: openssl rand -hex 32
DB_PASSWORD=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# User/group that owns the files
#PUID=1000
#PGID=1000

# Name of the reverse proxy network (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy

# Allow anyone who can reach the domain to create an account
#MEALIE_ALLOW_SIGNUP=false

# Outgoing email (STARTTLS) – EMAIL_FROM is a plain address here, e.g. mealie@example.com
#EMAIL_HOST=mail.example.com
#EMAIL_PORT=587
#EMAIL_USERNAME=
#EMAIL_PASSWORD=
#EMAIL_FROM=mealie@example.com
