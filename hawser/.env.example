# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Both values are shown in Dockhand when you add a new environment of type "Hawser (edge)"
HAWSER_SERVER_URL=wss://dockhand.example.com/...
HAWSER_TOKEN=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# Name of this host in Dockhand
#HAWSER_AGENT_NAME=

# Folder on this host with the stack folders Dockhand deploys here
#HAWSER_STACKS_DIR=/opt/stacks
