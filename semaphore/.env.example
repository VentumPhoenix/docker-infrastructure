# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain (without https://)
APP_DOMAIN=semaphore.example.com

# Database password – generate: openssl rand -hex 32
DB_PASSWORD=

# Password of the first admin (only used on the first start)
SEMAPHORE_ADMIN_PASSWORD=

# Encrypts stored SSH keys and passwords. Never change it after setup.
# Generate: head -c32 /dev/urandom | base64
SEMAPHORE_ACCESS_KEY_ENCRYPTION=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# Name of the reverse proxy network (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy

# First admin
#SEMAPHORE_ADMIN_USER=admin
#SEMAPHORE_ADMIN_EMAIL=admin@localhost
