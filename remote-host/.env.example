# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Optional parts on this host (comma-separated): hawser, beszel
COMPOSE_PROFILES=hawser,beszel

# Short name of this host (agent name in Dockhand, group of its proxy hosts in NPMplus)
REMOTE_HOST_NAME=vps1

# NetBird IPs of this host and of the central host (NPMplus, Dockhand, Beszel, Uptime Kuma)
NETBIRD_IP=100.64.0.2
NETBIRD_CENTRAL_IP=100.64.0.1

# Subnet of npm-proxy on THIS host, unique per host (the central host uses 172.30.0)
NPM_PROXY_NET_PREFIX=172.30.1

# Group ID of the Docker socket on this host: ls -ln /var/run/docker.sock
DOCKER_GID=

# NPMplus service account, the same as in the npmplus stack of the central host
NPM_SERVICE_USER=admin@example.com
NPM_SERVICE_PASSWORD=

# ════════════════════════════════════════════════════════════
#  REQUIRED FOR PROFILE hawser (Dockhand)
# ════════════════════════════════════════════════════════════

# Both values are shown in Dockhand when you add a new environment of type "Hawser (edge)"
#HAWSER_SERVER_URL=wss://dockhand.example.com/...
#HAWSER_TOKEN=

# ════════════════════════════════════════════════════════════
#  REQUIRED FOR PROFILE beszel
# ════════════════════════════════════════════════════════════

# URL of the Beszel hub, and key + token shown in the Beszel UI under "Add system"
#BESZEL_HUB_URL=https://beszel.example.com
#BESZEL_AGENT_KEY=
#BESZEL_AGENT_TOKEN=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# Network names (same as on the central host, so app stacks run unchanged)
#NPM_PROXY_NETWORK=npm-proxy
#SOCKET_PROXY_NETWORK=socket-proxy

# Subnets and bridge names on this host – change only if they collide
#SOCKET_PROXY_NET_PREFIX=172.31.0
#REMOTE_EGRESS_NET_PREFIX=172.28.0
#NPM_PROXY_BRIDGE=br-npm
#SOCKET_PROXY_BRIDGE=br-sockprx

# Port of the socket proxy (127.0.0.1 and NETBIRD_IP)
#SOCKET_PROXY_PORT=2375

# Hawser: folder on this host with the stack folders Dockhand deploys here
#HAWSER_STACKS_DIR=/opt/stacks

# Beszel: port the hub connects to (on NETBIRD_IP only)
#BESZEL_AGENT_PORT=45876

# Sync: forward-auth providers of the central NPMplus ("none" if it runs without Authentik)
#NPM_AUTH_REQUEST_PROVIDERS=authentik
