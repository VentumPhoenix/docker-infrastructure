# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain (without https://)
APP_DOMAIN=grafana.example.com

# Password of the local admin user
GRAFANA_ADMIN_PASSWORD=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# Name of the reverse proxy network (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy

# Name of the local admin user
#GRAFANA_ADMIN_USER=admin

# Login via Authentik (OIDC provider + application in Authentik)
#GRAFANA_OIDC_ENABLED=false
#AUTHENTIK_URL=https://auth.example.com:443
#GRAFANA_OIDC_CLIENT_ID=
#GRAFANA_OIDC_CLIENT_SECRET=
