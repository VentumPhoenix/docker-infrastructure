# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain (without https://)
APP_DOMAIN=code.example.com

# Argon2 hash of the code-server password, generate with:
#   echo -n 'your-password' | npx argon2-cli -e
# The hash contains "$", so keep the SINGLE quotes.
CODE_SERVER_HASHED_PASSWORD='$argon2id$v=19$...'

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# Name of the reverse proxy network (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy

# Folder opened as /home/coder/project. Default: Docker volume app-workspace.
# A host path must belong to UID 1000.
#CODE_SERVER_WORKSPACE=/srv/projects
