# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain (without https://)
APP_DOMAIN=status.example.com

# Uptime Kuma user that AutoKuma logs in with (create it in the UI first)
KUMA_SERVICE_USER=autokuma
# Generate: openssl rand -hex 32
KUMA_SERVICE_PASSWORD=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# Network names (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy
#SOCKET_PROXY_NETWORK=socket-proxy

# Address of the socket proxy
#SOCKET_PROXY_HOST=socket-proxy
#SOCKET_PROXY_PORT=2375
