# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain (without https://)
APP_DOMAIN=dockhand.example.com

# Database password – hex only, it's part of a URL. Generate: openssl rand -hex 32
DB_PASSWORD=

# ════════════════════════════════════════════════════════════
#  REQUIRED FOR docker-compose.hawser.yml (on another host)
# ════════════════════════════════════════════════════════════

# Both values are shown in Dockhand when you add a new environment of type "Hawser (edge)"
#HAWSER_SERVER_URL=wss://dockhand.example.com/...
#HAWSER_TOKEN=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# Name of the reverse proxy network (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy

# Folder on the host that contains the stack folders Dockhand deploys
#DOCKHAND_STACKS_DIR=/opt/stacks

# Hawser (other host): name of the host in Dockhand, and its stack folder
#HAWSER_AGENT_NAME=
#HAWSER_STACKS_DIR=/opt/stacks
