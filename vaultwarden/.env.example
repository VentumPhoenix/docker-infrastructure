# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain (without https://)
APP_DOMAIN=vault.example.com

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# Name of the reverse proxy network (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy

# Registration: anyone who can reach the domain may create an account
#VAULTWARDEN_SIGNUPS_ALLOWED=true
# Only allow these email domains to register, comma-separated (empty = all)
#VAULTWARDEN_SIGNUPS_DOMAINS=example.com
# Require a confirmed email address before the first login (needs the email block)
#VAULTWARDEN_SIGNUPS_VERIFY=false

# Admin page at /admin (empty = disabled). Use an Argon2 hash, not a plain password:
#   docker run --rm -it vaultwarden/server /vaultwarden hash
# The hash contains "$", so keep the SINGLE quotes.
#VAULTWARDEN_ADMIN_TOKEN='$argon2id$v=19$...'

# Outgoing email (STARTTLS) – needed for invitations, verification and 2FA by email
#EMAIL_HOST=mail.example.com
#EMAIL_PORT=587
#EMAIL_USERNAME=
#EMAIL_PASSWORD=
#EMAIL_FROM=no-reply@example.com
