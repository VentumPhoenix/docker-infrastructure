# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain (without https://)
APP_DOMAIN=git.example.com

# GitLab version (image tag), see https://hub.docker.com/r/gitlab/gitlab-ce/tags
# Upgrade along GitLab's upgrade path only: https://docs.gitlab.com/update/upgrade_paths/
APP_VERSION=

# Password of the root user (only used on the first start, at least 8 characters)
GITLAB_ROOT_PASSWORD=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# Name of the reverse proxy network and NPMplus subnet (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy
#NPM_PROXY_NET_PREFIX=172.30.0

# Host port for git over SSH
#GITLAB_SSH_PORT=2222

# Outgoing email (STARTTLS). No single quotes (') in the values, they end up in Ruby strings.
#EMAIL_HOST=mail.example.com
#EMAIL_PORT=587
#EMAIL_USERNAME=
#EMAIL_PASSWORD=
#EMAIL_FROM=gitlab@example.com
