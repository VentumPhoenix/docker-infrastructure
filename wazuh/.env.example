# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain of the dashboard (without https://)
APP_DOMAIN=wazuh.example.com

# Wazuh version of all three images (must match the version of the config folder)
APP_VERSION=4.14.11

# Passwords – they MUST match the config folder (see README "Changing the passwords").
# Indexer user "admin"            -> hash in wazuh_indexer/internal_users.yml
WAZUH_INDEXER_PASSWORD=
# Indexer user "kibanaserver"     -> hash in wazuh_indexer/internal_users.yml
WAZUH_DASHBOARD_PASSWORD=
# API user "wazuh-wui"            -> password in wazuh_dashboard/wazuh.yml
# 8-64 characters with upper and lower case, digit and symbol, or the manager won't start
WAZUH_API_PASSWORD=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Name of the reverse proxy network (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy

# Upstream config folder (single-node/config of wazuh-docker) on the host
#WAZUH_CONFIG_DIR=/opt/stacks/wazuh/config

# Host ports for the agents
#WAZUH_AGENT_PORT=1514
#WAZUH_ENROLLMENT_PORT=1515

# Java heap of the indexer
#WAZUH_INDEXER_HEAP=1g
