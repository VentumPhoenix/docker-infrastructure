# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain (without https://)
APP_DOMAIN=beszel.example.com

# ════════════════════════════════════════════════════════════
#  REQUIRED FOR VARIANT agent and docker-compose.remote-agent.yml
# ════════════════════════════════════════════════════════════

# Shown in the Beszel UI under "Add system"
#BESZEL_AGENT_KEY=
#BESZEL_AGENT_TOKEN=

# ════════════════════════════════════════════════════════════
#  REQUIRED FOR docker-compose.remote-agent.yml (on another host)
# ════════════════════════════════════════════════════════════

# URL of the Beszel hub
#BESZEL_HUB_URL=https://beszel.example.com

# Group ID of the Docker socket on that host: ls -ln /var/run/docker.sock
#DOCKER_GID=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# Name of the reverse proxy network (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy

# Variant agent: address of the socket proxy (must match the npmplus stack)
#SOCKET_PROXY_NET_PREFIX=172.31.0
#SOCKET_PROXY_PORT=2375

# Remote agent: port the hub connects to, and localhost port of its socket proxy
#BESZEL_AGENT_PORT=45876
#BESZEL_SOCKET_PROXY_PORT=2375
