# ════════════════════════════════════════════════════════════
#  REQUIRED – the stack won't start without these
# ════════════════════════════════════════════════════════════

# Public domain (without https://)
APP_DOMAIN=docs.example.com

# Database password – generate: openssl rand -hex 32
DB_PASSWORD=

# Key for signing sessions and tokens – generate: openssl rand -hex 32
PAPERLESS_SECRET_KEY=

# ════════════════════════════════════════════════════════════
#  OPTIONAL – commented out = default is active
# ════════════════════════════════════════════════════════════

# Time zone
#TZ=Europe/Berlin

# User/group that owns the files
#PUID=1000
#PGID=1000

# Name of the reverse proxy network (must match the npmplus stack)
#NPM_PROXY_NETWORK=npm-proxy

# OCR languages, joined with + (deu, eng, fra, ita, spa are included in the image)
#PAPERLESS_OCR_LANGUAGE=deu+eng

# Folder for new documents. Default: Docker volume app-consume.
# Set a host path to use e.g. a scanner share.
#PAPERLESS_CONSUME_DIR=/srv/scans
